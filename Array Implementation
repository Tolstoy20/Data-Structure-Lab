class Stack:
    def __init__(data):
        data.stack = []

    def is_empty(data):
        return len(data.stack) == 0

    def push(data,value):
        data.stack.append(value)
        print(f"{value} has been added successfully inside the stack")

    def pop(data):
        if data.is_empty():
            return "Stack Under Flow"
        return data.stack.pop()

    def peek(data):
        if data.is_empty():
            return "Stack is Empty"
        return data.stack[-1]

    
    def size (data):
        return len(data.stack)

    def display(data):
        print("Stack elements : ",data.stack)


s = Stack()
s.push(10)
s.push(20)
s.push(30)
s.push(40)
s.push(50)

print("Popped Value : ",s.pop())
print("Top Value : ",s.peek())
s.display()
